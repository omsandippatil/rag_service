{
    "name": "Tap image feedback assessment",
    "description": "Validity assessment and feedback for image submissions.",
    "tag": "ASSESSMENT",
    "config_blob": {
        "input_schema": {
                "artwork_image": {
                    "type": "image",
                    "format": "url"
                },
                "submission_id": {
                    "type": "text",
                    "format": null
                },
                "rendered_prompt": {
                    "type": "text",
                    "format": null
                }
            },
        "assessment": {
                "type": "text",
                "params": {
                    "model": "claude-opus-5-5",
                    "submission": "{rendered_prompt}",
                    "instructions": "Execute the grading prompt provided in the submission against the attached image. Follow that prompt's rubric and scoring exactly. Return output strictly matching the JSON schema.",
                    "json_output_schema": {
                        "type": "object",
                        "required": [
                            "overall_feedback",
                            "overall_feedback_translated",
                            "submission_validity"
                        ],
                        "properties": {
                            "overall_feedback": {
                                "type": "string",
                                "description": "encouraging overall feedback"
                            },
                            "submission_validity": {
                                "type": "string",
                                "description": "validity of the submission, one of: valid or invalid"
                            },
                            "overall_feedback_translated": {
                                "type": "string",
                                "description": "overall feedback in the student's language as specified in the prompt. Use the appropriate script for the language."
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "provider": "anthropic"
            }
    }
}